# Bu dosyayi ".env" olarak kopyalayip değerleri doldurun.
# .env dosyası git'e gönderilmez.

# Token imzalama anahtarı. Üretimde ZORUNLU, rastgele ve gizli olmalıdır.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Sunucu portu
PORT=5000

# Token gecerlilik süresi (örnek: 24h, 7d)
TOKEN_TTL=24h

# Virgülle ayrılmış izin verilen frontend adresleri
CORS_ORIGINS=http://localhost:5173,https://parsan.engrare.com

# Yuklenebilecek en büyük resim boyutu (byte). Varsayilan 8 MB.
MAX_UPLOAD_BYTES=8388608

# Veritabanı bos ise örnek kullanıcıları oluştur (üretimde false bırakın)
SEED_USERS=false
SEED_PASSWORD=parsan123

# Üretimde: production
NODE_ENV=development

# --- E-posta bildirimleri (Resend) -----------------------------------------
# https://resend.com/api-keys adresinden alınır. Boş bırakılırsa e-posta
# gönderimi kapalı kalır; uygulama içi bildirimler çalışmaya devam eder.
RESEND_API_KEY=

# Gönderen adresi. Resend panelinde doğrulanmış bir alan adı olmalıdır.
RESEND_FROM=PARSAN Portal <bildirim@engrare.com>

# E-posta bildirimlerini tamamen kapatmak için false yapın.
EMAIL_NOTIFICATIONS=true

# E-postalardaki "Portalı Aç" bağlantısının kök adresi.
APP_URL=https://parsan.engrare.com

# Bölüm eşleşmese bile her zaman bilgilendirilecek adresler (virgülle).
NOTIFY_FALLBACK_EMAILS=
